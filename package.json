{
  "name": "skkg-mcp",
  "version": "0.5.0",
  "private": true,
  "description": "MCP server for the SKKG Sammlung digital collection (Stiftung für Kunst, Kultur und Geschichte, Winterthur)",
  "license": "MIT",
  "author": {
    "name": "Arno Bosse"
  },
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "bin": {
    "skkg-mcp": "src/index.js"
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "start": "node src/index.js",
    "serve": "node src/http.js",
    "test": "node --test \"test/*.test.js\"",
    "lint": "eslint .",
    "inspector": "npx @modelcontextprotocol/inspector node src/index.js",
    "mutate": "node test/mutations.mjs",
    "build:viewer": "node scripts/build-viewer.mjs",
    "dev:viewer": "vite dev -c apps/image-viewer/vite.config.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "~2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "~2.4.0",
    "eslint": "10.6.0",
    "globals": "17.7.0",
    "openseadragon": "6.1.1",
    "railway": "^3.16.0",
    "vite": "8.3.6",
    "vite-plugin-singlefile": "2.3.4"
  }
}
