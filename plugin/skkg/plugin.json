{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "skkg",
  "version": "0.5.0",
  "description": "Search the collection of the Stiftung für Kunst, Kultur und Geschichte (SKKG, Winterthur): about 64,000 objects with German metadata, provenance, acquisitions, literature, exhibitions and images.",
  "author": {
    "name": "University of Basel",
    "url": "https://rise.unibas.ch/en/"
  },
  "homepage": "https://github.com/kintopp/skkg-mcp",
  "repository": "https://github.com/kintopp/skkg-mcp",
  "license": "MIT",
  "keywords": [
    "skkg",
    "collection",
    "art",
    "provenance",
    "museum"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "SKKG Collection",
        "shortDescription": "Search the SKKG collection in Winterthur",
        "developerName": "University of Basel",
        "category": "Productivity",
        "websiteURL": "https://github.com/kintopp/skkg-mcp"
      }
    }
  }
}
